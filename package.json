{
    "name": "blocks-monorepo",
    "version": "0.0.0",
    "scripts": {
        "ng": "ng",
        "start": "ng serve",
        "prebuild": "npm run tools:build-effects && npm run tools:generate-tokens && node tools/version-sync.mjs",
        "build": "ng build",
        "watch": "ng build --watch --configuration development",
        "tools:sync:icons:lucide-categories": "node tools/icons/sync-lucide-categories.mjs",
        "tools:generate:icons:lucide": "node tools/icons/generate-lucide-icons.mjs",
        "tools:generate-tokens": "node tools/tokens/generate-tokens.mjs",
        "tools:generate:component-previews": "node tools/playground/generate-component-previews.mjs",
        "tools:sync-version": "node tools/version-sync.mjs",
        "version:blocks": "node tools/version-bump.mjs",
        "version:minor": "node tools/version-bump.mjs minor",
        "build:blocks": "npm run tools:build-effects && npm run tools:sync-version && npm run tools:generate:icons:lucide && npm run tools:generate-tokens && ng build blocks && node tools/restore-full-css-hex.mjs dist/blocks && tsc -p projects/blocks/tsconfig.schematics.json && node tools/paths/rewrite-output-aliases.mjs projects/blocks/tsconfig.schematics.json && copyfiles -u 2 projects/blocks/schematics/collection.json projects/blocks/schematics/*/schema.json dist/blocks",
        "test": "ng test",
        "test:themes": "node --test tools/tokens/themes.test.mjs",
        "test:navigation": "vitest run --config projects/blocks/navigation/vitest.config.mts && tsc -p projects/blocks/navigation/tsconfig.spec.json",
        "lint": "npm run lint:ts && npm run lint:scripts && npm run lint:angular && npm run lint:styles && npm run lint:format && npm run lint:docs",
        "lint:ts": "eslint --max-warnings=0 \"projects/blocks/**/*.{ts,html}\" \"projects/playground/**/*.{ts,html}\"",
        "lint:angular": "ngc -p tsconfig.eslint.json",
        "lint:staged": "lint-staged --hide-unstaged --no-stash",
        "lint:fix": "npm run lint:ts -- --fix && npm run lint:scripts -- --fix && npm run lint:styles:fix",
        "lint:format": "prettier --check .",
        "format": "prettier --write .",
        "lint:styles": "stylelint --max-warnings 0 \"projects/blocks/**/*.scss\" \"projects/playground/**/*.scss\" && prettier --check \"projects/blocks/**/*.scss\" \"projects/playground/**/*.scss\"",
        "lint:styles:fix": "prettier --write \"projects/blocks/**/*.scss\" \"projects/playground/**/*.scss\" && stylelint --fix \"projects/blocks/**/*.scss\" \"projects/playground/**/*.scss\" && prettier --write \"projects/blocks/**/*.scss\" \"projects/playground/**/*.scss\"",
        "lint:blocks": "ng lint blocks --max-warnings 0 && stylelint --max-warnings 0 \"projects/blocks/**/*.scss\" && prettier --check \"projects/blocks/**/*.scss\"",
        "lint:playground": "ng lint playground --max-warnings 0 && stylelint --max-warnings 0 \"projects/playground/**/*.scss\" && prettier --check \"projects/playground/**/*.scss\"",
        "prepare": "husky",
        "tools:build-docs": "node tools/docs/build-docs.mjs",
        "prestart": "npm run tools:build-effects && npm run tools:generate-tokens && npm run tools:generate:component-previews && npm run tools:sync-version && npm run tools:build-docs",
        "prewatch": "npm run tools:build-effects && npm run tools:generate-tokens && npm run tools:generate:component-previews && npm run tools:sync-version && npm run tools:build-docs",
        "build:playground": "npm run tools:build-effects && npm run tools:generate-tokens && npm run tools:generate:component-previews && npm run tools:sync-version && npm run tools:build-docs && ng build playground",
        "deploy:playground": "npm run tools:build-effects && npm run tools:generate-tokens && npm run tools:generate:component-previews && npm run tools:sync-version && npm run tools:build-docs && ng deploy playground --base-href=/Blocks/",
        "tools:build-effects": "node tools/build-effects-styles.mjs",
        "lint:scripts": "eslint --max-warnings=0 \"tools/**/*.{js,mjs,cjs}\" \"*.config.{js,mjs,cjs}\"",
        "lint:docs": "markdownlint-cli2",
        "tools:sync-theme-types": "npm run tools:generate-tokens",
        "test:stepper": "ng test blocks --watch=false --include='navigation/components/stepper/**/*.spec.ts' --include='navigation/components/step/**/*.spec.ts'",
        "test:motion": "ng test blocks --watch=false"
    },
    "private": true,
    "workspaces": [
        "projects/blocks",
        "projects/playground"
    ],
    "dependencies": {
        "@angular/animations": "^22.2.4",
        "@angular/cdk": "^22.2.4",
        "@angular/common": "^22.2.4",
        "@angular/compiler": "^22.2.4",
        "@angular/core": "^22.2.4",
        "@angular/forms": "^22.2.4",
        "@angular/platform-browser": "^22.2.4",
        "@angular/platform-browser-dynamic": "^22.2.4",
        "@angular/platform-server": "^22.2.4",
        "@angular/router": "^22.2.4",
        "@angular/ssr": "^22.2.4",
        "@modelcontextprotocol/sdk": "^1.26.0",
        "express": "^5.1.0",
        "ngx-highlightjs": "^14.0.1",
        "rxjs": "~7.8.0",
        "tslib": "^2.3.0"
    },
    "devDependencies": {
        "@ampproject/remapping": "^2.3.0",
        "@angular-devkit/architect": "0.2202.4",
        "@angular-eslint/eslint-plugin": "^22.6.0",
        "@angular-eslint/eslint-plugin-template": "^22.6.0",
        "@angular-eslint/template-parser": "^22.6.0",
        "@angular/build": "^22.2.6",
        "@angular/cli": "22.2.4",
        "@angular/compiler-cli": "22.2.4",
        "@eslint/js": "^9.39.2",
        "@jridgewell/sourcemap-codec": "^1.6.0",
        "@types/express": "^5.0.1",
        "@types/jasmine": "~5.1.0",
        "@types/jest": "^30.0.0",
        "@types/node": "^20.17.19",
        "angular-cli-ghpages": "^3.0.2",
        "angular-eslint": "^22.6.0",
        "copyfiles": "^2.4.1",
        "eslint": "^9.39.2",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.5",
        "eslint-plugin-simple-import-sort": "^12.1.1",
        "husky": "^9.1.7",
        "jasmine-core": "~5.4.0",
        "jsdom": "^27.1.0",
        "karma": "~6.4.0",
        "karma-chrome-launcher": "~3.2.0",
        "karma-coverage": "~2.2.0",
        "karma-jasmine": "~5.1.0",
        "karma-jasmine-html-reporter": "~2.1.0",
        "lint-staged": "^16.4.0",
        "lucide-static": "^1.8.0",
        "magic-string": "^1.4.5",
        "markdownlint-cli2": "^0.24.1",
        "marked": "^18.1.2",
        "ng-packagr": "^22.2.4",
        "postcss-scss": "^4.0.9",
        "prettier": "^3.8.1",
        "prettier-plugin-tailwindcss": "^0.7.2",
        "stylelint": "^17.16.0",
        "stylelint-config-standard-scss": "^17.0.0",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.72.1",
        "vitest": "^4.0.8"
    },
    "engines": {
        "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
    },
    "overrides": {
        "@typescript-eslint/typescript-estree": {
            "minimatch": "^11.0.1",
            "vite": "^6.2.0"
        },
        "micromark-extension-math": {
            "katex": "0.19.1"
        }
    }
}
