{
    "name": "blocks-monorepo",
    "version": "0.0.0",
    "scripts": {
        "ng": "ng",
        "start": "ng serve",
        "prebuild": "node tools/version-sync.mjs",
        "build": "ng build",
        "watch": "ng build --watch --configuration development",
        "tools:generate:icons:lucide": "node tools/icons/generate-lucide-icons.mjs",
        "tools:sync-theme-types": "node tools/tokens/sync-theme-types.mjs",
        "tools:sync-version": "node tools/version-sync.mjs",
        "build:blocks": "npm run tools:sync-effects-tokens && npm run tools:sync-version && npm run tools:generate:icons:lucide && npm run tools:sync-theme-types && ng build blocks && tsc -p projects/blocks/tsconfig.schematics.json && copyfiles -u 2 projects/blocks/schematics/collection.json projects/blocks/schematics/*/schema.json dist/blocks",
        "test": "ng test",
        "lint": "npm run lint:ts && npm run lint:styles",
        "lint:ts": "eslint \"projects/blocks/**/*.{ts,html}\" \"projects/playground/**/*.{ts,html}\"",
        "lint:styles": "stylelint \"projects/blocks/**/*.scss\" \"projects/playground/**/*.scss\" && prettier --check --tab-width 4 \"projects/blocks/**/*.scss\" \"projects/playground/**/*.scss\"",
        "lint:styles:fix": "prettier --write --tab-width 4 \"projects/blocks/**/*.scss\" \"projects/playground/**/*.scss\" && stylelint --fix \"projects/blocks/**/*.scss\" \"projects/playground/**/*.scss\" && prettier --write --tab-width 4 \"projects/blocks/**/*.scss\" \"projects/playground/**/*.scss\"",
        "lint:blocks": "ng lint blocks && stylelint \"projects/blocks/**/*.scss\" && prettier --check --tab-width 4 \"projects/blocks/**/*.scss\"",
        "lint:playground": "ng lint playground && stylelint \"projects/playground/**/*.scss\" && prettier --check --tab-width 4 \"projects/playground/**/*.scss\"",
        "tools:build-docs": "node tools/docs/build-docs.mjs",
        "tools:sync-effects-tokens": "node tools/sync-effects-tokens.mjs",
        "prestart": "npm run tools:build-docs",
        "prewatch": "npm run tools:build-docs",
        "build:playground": "npm run tools:build-docs && ng build playground",
        "deploy:playground": "npm run tools:build-docs && ng deploy playground --base-href=/Blocks/"
    },
    "prettier": {
        "printWidth": 100,
        "singleQuote": true,
        "overrides": [
            {
                "files": "*.html",
                "options": {
                    "parser": "angular"
                }
            }
        ]
    },
    "private": true,
    "workspaces": [
        "projects/blocks",
        "projects/playground"
    ],
    "dependencies": {
        "@angular/animations": "^22.2.3",
        "@angular/cdk": "^22.2.4",
        "@angular/common": "^22.2.3",
        "@angular/compiler": "^22.2.3",
        "@angular/core": "^22.2.3",
        "@angular/forms": "^22.2.3",
        "@angular/platform-browser": "^22.2.3",
        "@angular/platform-browser-dynamic": "^22.2.3",
        "@angular/platform-server": "^22.2.3",
        "@angular/router": "^22.2.3",
        "@angular/ssr": "^22.2.4",
        "@modelcontextprotocol/sdk": "^1.26.0",
        "express": "^5.1.0",
        "mermaid": "^10.9.5",
        "ngx-highlightjs": "^14.0.1",
        "ngx-markdown": "^22.1.1",
        "oddity-angular": "^0.2.1",
        "rxjs": "~7.8.0",
        "tslib": "^2.3.0"
    },
    "devDependencies": {
        "@angular-eslint/eslint-plugin": "^22.6.0",
        "@angular-eslint/eslint-plugin-template": "^22.6.0",
        "@angular-eslint/template-parser": "^22.6.0",
        "@angular/build": "^22.2.4",
        "@angular/cli": "^22.2.4",
        "@angular/compiler-cli": "^22.2.3",
        "@eslint/js": "^9.39.2",
        "@types/express": "^5.0.1",
        "@types/jasmine": "~5.1.0",
        "@types/node": "^20.17.19",
        "angular-cli-ghpages": "^3.0.2",
        "angular-eslint": "^22.6.0",
        "copyfiles": "^2.4.1",
        "eslint": "^9.39.2",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prefer-arrow": "^1.2.3",
        "eslint-plugin-prettier": "^5.5.5",
        "eslint-plugin-sort-class-members": "^1.21.0",
        "jasmine-core": "~5.4.0",
        "jsdom": "^27.1.0",
        "karma": "~6.4.0",
        "karma-chrome-launcher": "~3.2.0",
        "karma-coverage": "~2.2.0",
        "karma-jasmine": "~5.1.0",
        "karma-jasmine-html-reporter": "~2.1.0",
        "lucide-static": "^1.8.0",
        "marked": "^18.1.2",
        "ng-packagr": "^22.2.5",
        "prettier": "^3.8.1",
        "prettier-plugin-tailwindcss": "^0.7.2",
        "stylelint": "^17.16.0",
        "stylelint-config-standard-scss": "^17.0.0",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.72.1",
        "vitest": "^4.0.8"
    },
    "engines": {
        "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
    }
}
