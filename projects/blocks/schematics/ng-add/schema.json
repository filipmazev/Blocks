{
    "$schema": "http://json-schema.org/draft-07/schema",
    "$id": "BlocksNgAddSchema",
    "title": "Blocks Initialization Options",
    "type": "object",
    "properties": {
        "theme": {
            "type": "string",
            "description": "Select a Blocks palette for your UI.",
            "enum": [
                "graphite-sky-blue",
                "azure-coral",
                "violet-teal",
                "tangerine-indigo",
                "scarlet-cyan",
                "lime-violet",
                "cyberpunk",
                "white",
                "blue",
                "purple",
                "orange",
                "red",
                "green"
            ],
            "x-prompt": {
                "message": "Which palette would you like to use?",
                "type": "list",
                "items": [
                    {
                        "value": "graphite-sky-blue",
                        "label": "Graphite / Sky Blue"
                    },
                    {
                        "value": "azure-coral",
                        "label": "Azure / Coral"
                    },
                    {
                        "value": "violet-teal",
                        "label": "Violet / Teal"
                    },
                    {
                        "value": "tangerine-indigo",
                        "label": "Tangerine / Indigo"
                    },
                    {
                        "value": "scarlet-cyan",
                        "label": "Scarlet / Cyan"
                    },
                    {
                        "value": "lime-violet",
                        "label": "Lime / Violet"
                    },
                    {
                        "value": "cyberpunk",
                        "label": "Cyberpunk"
                    }
                ]
            },
            "default": "graphite-sky-blue"
        }
    }
}
