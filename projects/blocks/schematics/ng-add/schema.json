{
    "$schema": "http://json-schema.org/draft-07/schema",
    "$id": "BlocksNgAddSchema",
    "title": "Blocks Initialization Options",
    "type": "object",
    "properties": {
        "theme": {
            "type": "string",
            "description": "Select a Blocks palette for your UI.",
            "enum": [
                "carbon-cobalt",
                "azure-ember",
                "violet-teal",
                "tangerine-indigo",
                "brick-rose-cyan",
                "lime-violet",
                "cyberpunk"
            ],
            "x-prompt": {
                "message": "Which palette would you like to use?",
                "type": "list",
                "items": [
                    {
                        "value": "carbon-cobalt",
                        "label": "Carbon / Cobalt"
                    },
                    {
                        "value": "azure-ember",
                        "label": "Azure / Ember"
                    },
                    {
                        "value": "violet-teal",
                        "label": "Violet / Teal"
                    },
                    {
                        "value": "tangerine-indigo",
                        "label": "Tangerine / Indigo"
                    },
                    {
                        "value": "brick-rose-cyan",
                        "label": "Brick Rose / Cyan"
                    },
                    {
                        "value": "lime-violet",
                        "label": "Lime / Violet"
                    },
                    {
                        "value": "cyberpunk",
                        "label": "Cyberpunk"
                    }
                ]
            },
            "default": "carbon-cobalt"
        }
    }
}
