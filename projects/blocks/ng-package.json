{
    "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
    "dest": "../../dist/blocks",
    "lib": {
        "entryFile": "src/public-api.ts"
    },
    "assets": [
        "schematics/**/*.json",
        "schematics/**/*.js",
        "schematics/**/*.d.ts",
        "core/styles/**/*.scss",
        "_index.scss",
        "effects/**/*.scss",
        "effects/THIRD_PARTY_NOTICES.md",
        {
            "glob": "effects.css",
            "input": "effects",
            "output": "effects"
        }
    ]
}
